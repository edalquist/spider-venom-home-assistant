      "mac_address": { "default": "mdi:network" },
      "main_temp": { "default": "mdi:thermometer" },
      "target_min": { "default": "mdi:thermometer-low" },
      "target_max": { "default": "mdi:thermometer-high" },
      "heat_intensity": { "default": "mdi:fan" },
      "heat_start_time": { "default": "mdi:clock-start" },
      "high_temp_limit": { "default": "mdi:thermometer-alert" },
      "low_temp_limit": { "default": "mdi:thermometer-alert" },
      "rssi": { "default": "mdi:wifi" },
      "ssid": { "default": "mdi:wifi-settings" },
      "bssid": { "default": "mdi:access-point" },
      "update_flag": { "default": "mdi:update" },
      "trigger_flag": { "default": "mdi:flag" },
      "errors": { "default": "mdi:alert-circle" },
      "shadow_last_updated": { "default": "mdi:cloud-clock" },
      "last_reported": { "default": "mdi:clock-check" },
